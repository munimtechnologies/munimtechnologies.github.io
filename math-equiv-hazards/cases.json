{
  "name": "math-equiv-hazards",
  "version": "0.1.0",
  "license": "CC-BY-4.0",
  "upstream_commits": {
    "EleutherAI/lm-evaluation-harness": "d42a3e4482fad0c2587672254c24ad62afaa5702",
    "hendrycks/math": "940d1bf8d976b7e2afa9059a52350ffcdc880c1c",
    "volcengine/verl": "d73e600f49ea78b5c35219cc60ddd46b5bf305f1"
  },
  "fields": {
    "path": "is_equiv: is_equiv(prediction, gold); lm_eval_response: lm-eval hendrycks_math process_results(response, solution); verl_reward: verl math_reward.compute_score(solution_str, ground_truth)",
    "lm_eval": "result under lm-evaluation-harness (fix_a_slash_b catches AssertionError only)",
    "catch_all": "result under hendrycks/math original and verl (fix_a_slash_b catches everything)",
    "semantically_correct": "whether the prediction states the same single final answer as the gold (hand label)",
    "hazard": "true if either variant disagrees with semantically_correct"
  },
  "cases": [
    {"id": "A1", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "2 \\text{ or } 3", "gold": "2",
     "lm_eval": true, "catch_all": true, "semantically_correct": false, "hazard": true,
     "note": "remove_right_units keeps only the text before the first '\\text{ ', so a hedged two-option answer is credited for its first option."},
    {"id": "A2", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "2 \\text{ or } 3", "gold": "3",
     "lm_eval": false, "catch_all": false, "semantically_correct": false, "hazard": false,
     "note": "Control: the second option is discarded, so only the first-listed option can be credited."},
    {"id": "A3", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "x = 2 \\text{ or } x = 3", "gold": "2",
     "lm_eval": true, "catch_all": true, "semantically_correct": false, "hazard": true,
     "note": "Truncation leaves 'x = 2 ', then the short-lhs '=' strip leaves '2'."},
    {"id": "A4", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "7 \\text{ is a guess, the correct value is } 12", "gold": "7",
     "lm_eval": true, "catch_all": true, "semantically_correct": false, "hazard": true,
     "note": "A self-correcting answer whose final claim is 12 is credited for the abandoned 7."},
    {"id": "A5", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "2 \\text{ or } 3 \\text{ or } 4", "gold": "2",
     "lm_eval": false, "catch_all": false, "semantically_correct": false, "hazard": false,
     "note": "Control: three '\\text{ ' pieces fail the assert; is_equiv falls back to raw equality. Two options are credited, three are not."},
    {"id": "A6", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "5 \\text{ cm}", "gold": "5",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: the intended unit strip."},
    {"id": "A7", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "5 \\text{ hours}", "gold": "5 \\text{ minutes}",
     "lm_eval": true, "catch_all": true, "semantically_correct": false, "hazard": true,
     "note": "Known: wrong unit credited (reported for OpenRLHF's copy in OpenRLHF/OpenRLHF#1364). Included for completeness."},
    {"id": "A8", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "2 \\text{or} 3", "gold": "2",
     "lm_eval": false, "catch_all": false, "semantically_correct": false, "hazard": false,
     "note": "Control: without the space after the brace nothing is truncated."},
    {"id": "A9", "group": "A-text-truncation", "path": "is_equiv",
     "prediction": "2 \\text{ and } 3", "gold": "2, 3",
     "lm_eval": false, "catch_all": false, "semantically_correct": true, "hazard": true,
     "note": "The same truncation drops a complete two-solution answer: '2' vs '2,3'."},
    {"id": "B1", "group": "B-equals-spacing", "path": "is_equiv",
     "prediction": "x = 5", "gold": "5",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: lhs 'x ' has length 2, so 'x =' is stripped."},
    {"id": "B2", "group": "B-equals-spacing", "path": "is_equiv",
     "prediction": " x = 5", "gold": "5",
     "lm_eval": false, "catch_all": false, "semantically_correct": true, "hazard": true,
     "note": "One leading space makes the lhs ' x ' length 3; the strip is skipped and 'x=5' != '5'."},
    {"id": "B3", "group": "B-equals-spacing", "path": "is_equiv",
     "prediction": "xy = 5", "gold": "5",
     "lm_eval": false, "catch_all": false, "semantically_correct": true, "hazard": true,
     "note": "lhs length is measured before spaces are removed: 'xy ' is 3, so not stripped (for a question asking for xy)."},
    {"id": "B4", "group": "B-equals-spacing", "path": "is_equiv",
     "prediction": "xy=5", "gold": "5",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: unspaced 'xy' is length 2 and is stripped."},
    {"id": "C1", "group": "C-sign-asymmetry", "path": "is_equiv",
     "prediction": "1/2", "gold": "\\frac{1}{2}",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: fix_a_slash_b rescues a/b."},
    {"id": "C2", "group": "C-sign-asymmetry", "path": "is_equiv",
     "prediction": "-1/2", "gold": "-\\frac{1}{2}",
     "lm_eval": false, "catch_all": false, "semantically_correct": true, "hazard": true,
     "note": "int('-1') succeeds, giving '\\frac{-1}{2}', but MATH golds write '-\\frac{1}{2}'."},
    {"id": "C3", "group": "C-sign-asymmetry", "path": "is_equiv",
     "prediction": "0.5", "gold": "\\frac{1}{2}",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: the hard-coded '0.5' rescue."},
    {"id": "C4", "group": "C-sign-asymmetry", "path": "is_equiv",
     "prediction": "-0.5", "gold": "-\\frac{1}{2}",
     "lm_eval": false, "catch_all": false, "semantically_correct": true, "hazard": true,
     "note": "The rescue is an exact string test (string == '0.5'), so its negative is not rescued."},
    {"id": "D1", "group": "D-valueerror-fallback", "path": "is_equiv",
     "prediction": "\\dfrac{3}{2}\\text{m/s}", "gold": "\\frac{3}{2}\\text{m/s}",
     "lm_eval": false, "catch_all": true, "semantically_correct": true, "hazard": true,
     "note": "lm-eval only: one '/' sends a non-integer to int(); the ValueError escapes fix_a_slash_b, is_equiv discards all normalization and compares raw strings, so dfrac != frac."},
    {"id": "D2", "group": "D-valueerror-fallback", "path": "is_equiv",
     "prediction": "\\dfrac{3}{2}\\text{m}", "gold": "\\frac{3}{2}\\text{m}",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: without a '/' the same pair is equal in every copy."},
    {"id": "E1", "group": "E-left-right-substring", "path": "is_equiv",
     "prediction": "\\rightarrow", "gold": "\\leftarrow",
     "lm_eval": true, "catch_all": true, "semantically_correct": false, "hazard": true,
     "note": "Deleting the substrings '\\left' and '\\right' turns both arrows into 'arrow'. Rare in MATH golds."},
    {"id": "E2", "group": "E-left-right-substring", "path": "is_equiv",
     "prediction": "\\left( 1, 2 \\right)", "gold": "(1,2)",
     "lm_eval": true, "catch_all": true, "semantically_correct": true, "hazard": false,
     "note": "Control: the intended delimiter strip."},
    {"id": "R1", "group": "A-text-truncation", "path": "lm_eval_response",
     "response": "So $x = 2 \\text{ or } x = 3$.", "solution": "Thus $x = \\boxed{2}$.",
     "score": 1, "semantically_correct": false, "hazard": true,
     "note": "End to end through hendrycks_math process_results: exact_match 1 for a hedged answer."},
    {"id": "R2", "group": "B-equals-spacing", "path": "lm_eval_response",
     "response": "The answer is $x = 5$.", "solution": "So $x = \\boxed{5}$.",
     "score": 1, "semantically_correct": true, "hazard": false,
     "note": "Control."},
    {"id": "R3", "group": "B-equals-spacing", "path": "lm_eval_response",
     "response": "The answer is $ x = 5$.", "solution": "So $x = \\boxed{5}$.",
     "score": 0, "semantically_correct": true, "hazard": true,
     "note": "End to end: a space after the opening '$' turns a correct answer into exact_match 0."},
    {"id": "V1", "group": "A-text-truncation", "path": "verl_reward",
     "response": "Therefore the answer is \\boxed{2 \\text{ or } 3}.", "solution": "2",
     "score": 1.0, "semantically_correct": false, "hazard": true,
     "note": "verl's MATH reward pays 1.0 for a boxed hedge whose first option is right."},
    {"id": "V2", "group": "A-text-truncation", "path": "verl_reward",
     "response": "Therefore the answer is \\boxed{2 \\text{ or } 3}.", "solution": "3",
     "score": 0.0, "semantically_correct": false, "hazard": false,
     "note": "Control: the same hedge earns 0.0 when only its second option is right."},
    {"id": "V3", "group": "A-text-truncation", "path": "verl_reward",
     "response": "Therefore the answer is \\boxed{2}.", "solution": "2",
     "score": 1.0, "semantically_correct": true, "hazard": false,
     "note": "Control."}
  ]
}
